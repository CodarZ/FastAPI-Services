# ============== 基础环境与服务配置 ==============
# 运行环境: development | test | production
ENVIRONMENT=development
FASTAPI_TITLE=FastAPI Services
FASTAPI_DESCRIPTION=基于 FastAPI 构建的后端服务架构模板
FASTAPI_DOCS_URL=/docs
FASTAPI_REDOC_URL=/redoc
FASTAPI_OPENAPI_URL=/openapi.json
FASTAPI_STATIC_FILES=false

# ============== 时间与时区 ==============
DATETIME_FORMAT=%Y-%m-%dT%H:%M:%S
DATETIME_TIMEZONE=Asia/Shanghai

# ============== 多租户与 Schema 隔离配置 ==============
TENANT_ENABLED=true
TENANT_DEFAULT_SCHEMA=public
TENANT_HEADER_KEY=X-Tenant-ID
TENANT_SCHEMA_PREFIX=tenant_
TENANT_SCHEMA_PATTERN=^[a-z][a-z0-9_]{1,62}$

# ============== PostgreSQL 数据库配置 ==============
DATABASE_URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/fs_db
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_USE_LIFO=false

# ============== Redis 缓存配置 ==============
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=fs:
REDIS_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50

# ============== Celery 异步任务与定时调度 ==============
CELERY_BROKER_URL=amqp://user:pass@localhost:5672//
CELERY_BACKEND_URL=redis://127.0.0.1:6379/2
CELERY_TASK_DEFAULT_QUEUE=fs_tasks
CELERY_TIMEZONE=Asia/Shanghai

# ============== 限流配置 (Pyrate Limiter) ==============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RATE=60
RATE_LIMIT_DEFAULT_PERIOD=60
RATE_LIMIT_REDIS_URL=

# ============== 实时通信 (Socket.IO) ==============
SOCKETIO_PATH=/ws
SOCKETIO_REDIS_URL=
SOCKETIO_CORS_ALLOWED_ORIGINS=["*"]
SOCKETIO_ASYNC_MODE=asgi

# ============== IP 属地解析 (IP2Region) ==============
IP2REGION_ENABLED=true

# ============== 中间件与跨域访问控制 (CORS) ==============
MIDDLEWARE_CORS=true
# 生产环境建议替换为具体前端域名列表，且若允许凭据 (Credentials) 则禁止通配符 "*"
CORS_ALLOWED_ORIGINS=["*"]
CORS_EXPOSE_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============== 请求上下文与链路追踪 ==============
TRACE_ID_HEADER=X-Request-ID
TRACE_ID_LOG_DEFAULT=-

# ============== 请求访问日志与脱敏 ==============
REQUEST_LOG_ENABLE=true
REQUEST_LOG_EXCLUDE_PATHS=["/favicon.ico","/docs","/redoc","/openapi.json","/health","/admin/health","/api/health"]
REQUEST_LOG_ENCRYPT_FIELDS=["password","old_password","new_password","confirm_password","token","access_token","refresh_token","secret"]

# ============== 日志系统配置 (Loguru) ==============
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=INFO
LOG_ACCESS_FILENAME=access.log
LOG_ERROR_FILENAME=error.log
LOG_RETENTION=30 days
LOG_ROTATION=00:00
# 控制台与标准输出日志格式模板 (Loguru 标签语法)
LOG_STD_FORMAT=<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</> | <lvl>{level: <8}</> | <cyan>{extra[request_id]}</> | <lvl>{message}</>


# ============== 验证码配置 (Captcha) ==============
CAPTCHA_EXPIRE_SECONDS=300

# ============== 安全凭证与令牌配置 (JWT & Token) ==============
# JWT 签名秘钥 (生产环境务必替换为强随机密钥，长度 >= 32 字符，如 os.urandom(32).hex()，禁止使用 changeme 等占位密钥)
TOKEN_SECRET_KEY=changeme_in_production_32b_secret_key
TOKEN_ALGORITHM=HS256
TOKEN_EXPIRE_SECONDS=259200
TOKEN_REFRESH_EXPIRE_SECONDS=604800
TOKEN_ISSUER=fs
TOKEN_AUDIENCE_ADMIN=fs:admin
TOKEN_AUDIENCE_CLIENT=fs:client

# ============== 安全 Cookie 配置 (Refresh Token) ==============
COOKIE_REFRESH_TOKEN_KEY=fs_refresh_token
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/
